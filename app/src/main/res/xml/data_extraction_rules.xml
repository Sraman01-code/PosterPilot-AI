<?xml version="1.0" encoding="utf-8"?>
<!--
  PosterPilot AI keeps the user's business profile, exported PNGs, and history
  on-device only. We do not opt this app into Auto Backup / Cloud Backup or
  Device Transfer for v0.1, so users' data never leaves the device without
  their explicit Share action.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
